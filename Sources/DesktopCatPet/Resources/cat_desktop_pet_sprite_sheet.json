{
  "image": "cat_desktop_pet_sprite_sheet.png",
  "atlasSize": {
    "width": 2048,
    "height": 3072
  },
  "frameSize": {
    "width": 512,
    "height": 512
  },
  "grid": {
    "columns": 4,
    "rows": 6,
    "order": "left-to-right, top-to-bottom"
  },
  "animations": {
    "idle_front": {
      "fps": 2,
      "loop": true,
      "anchor": {
        "x": 256,
        "y": 460
      },
      "frames": [
        { "x": 0, "y": 0, "w": 512, "h": 512 },
        { "x": 512, "y": 0, "w": 512, "h": 512 }
      ]
    },
    "walk_right": {
      "fps": 8,
      "loop": true,
      "anchor": {
        "x": 256,
        "y": 430
      },
      "frames": [
        { "x": 0, "y": 512, "w": 512, "h": 512 },
        { "x": 512, "y": 512, "w": 512, "h": 512 },
        { "x": 1024, "y": 512, "w": 512, "h": 512 },
        { "x": 1536, "y": 512, "w": 512, "h": 512 }
      ]
    },
    "walk_left": {
      "fps": 8,
      "loop": true,
      "anchor": {
        "x": 256,
        "y": 430
      },
      "frames": [
        { "x": 0, "y": 1024, "w": 512, "h": 512 },
        { "x": 512, "y": 1024, "w": 512, "h": 512 },
        { "x": 1024, "y": 1024, "w": 512, "h": 512 },
        { "x": 1536, "y": 1024, "w": 512, "h": 512 }
      ]
    },
    "clicked_happy": {
      "fps": 6,
      "loop": false,
      "anchor": {
        "x": 256,
        "y": 460
      },
      "frames": [
        { "x": 0, "y": 1536, "w": 512, "h": 512 },
        { "x": 512, "y": 1536, "w": 512, "h": 512 },
        { "x": 1024, "y": 1536, "w": 512, "h": 512 }
      ]
    },
    "dragged": {
      "fps": 3,
      "loop": true,
      "anchor": {
        "x": 256,
        "y": 256
      },
      "frames": [
        { "x": 0, "y": 2048, "w": 512, "h": 512 },
        { "x": 512, "y": 2048, "w": 512, "h": 512 }
      ]
    },
    "sleep": {
      "fps": 2,
      "loop": true,
      "anchor": {
        "x": 256,
        "y": 350
      },
      "frames": [
        { "x": 0, "y": 2560, "w": 512, "h": 512 },
        { "x": 512, "y": 2560, "w": 512, "h": 512 },
        { "x": 1024, "y": 2560, "w": 512, "h": 512 }
      ]
    }
  }
}
